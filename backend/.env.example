# PostgreSQL / Neon PostgreSQL
# fullstack-guardian: Include prepareThreshold=0 in the URL directly so the
# application.properties doesn't need to guess the correct separator.
# Required for Supabase/Neon/PgBouncer in transaction-pooling mode — without
# this, JDBC creates named prepared statements that clash across pooled connections.
#
# No existing params (local dev):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/proctordb?prepareThreshold=0
# With existing params (Neon/Supabase — add &prepareThreshold=0 at the end):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.region.aws.neon.tech/dbname?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=proctor
SPRING_DATASOURCE_PASSWORD=
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Redis: use SPRING_DATA_REDIS_URL for a hosted URL, or the fields below.
# SPRING_DATA_REDIS_URL=rediss://default:<upstash-token>@<host>:6379
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL=false
REDIS_CONNECT_TIMEOUT=5s
REDIS_COMMAND_TIMEOUT=3s

# JWT
JWT_SECRET=base64-encoded-256-bit-secret
JWT_EXPIRATION_MS=900000

# AI Service
AI_SERVICE_URL=http://ai-service:8000
# secure-code-guardian: shared secret between Spring backend and AI service.
# Generate with: openssl rand -hex 32
# Must match AI_SERVICE_API_KEY set in the ai-service container.
AI_SERVICE_API_KEY=

# Frontend URL (used in invitation activation email links)
FRONTEND_URL=http://localhost:5173

# Bootstrap flag — set to false after SUPER_ADMIN account has been created
# to permanently close /api/auth/register (secure-code-guardian: reduce attack surface)
AUTH_BOOTSTRAP_ENABLED=true

# WebSocket allowed origins (comma-separated, restrict in production)
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# Judge0 (get free key from https://rapidapi.com/judge0-official/api/judge0-ce)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=<your-rapidapi-key>
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
